<div class="asmrow {% if include.highlight -%}asmrow-highlighted{%- endif -%}">
{%- assign temp=include.label | strip | slice:0,1 -%}
<div class="asmline-label {% if temp=="." %}asmline-sublabel{% endif %}">{{ include.label | default: "" }}</div><div class="asmline-address">{{ include.addr | default: "" }}</div><div class="asmline-mcode">{{ include.bytes | default: "" }}</div>{% include asmcode code=include.code %}<div class="asmline-comment">{% if include.comment %}; {% endif %}{{ include.comment | default: "" }}</div>
</div>